{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HTTP Widgets",
  "version": "2.0.2",
  "identifier": "com.hybes.http-widget",
  "build": {
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "iOS": {
      "developmentTeam": "BBU4YNR4U3"
    }
  }
}
